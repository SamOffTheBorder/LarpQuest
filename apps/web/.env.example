# Copy to .env.local and fill in. Never commit .env.local.

# --- App ---
# Absolute origin used to build magic-link redirect URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — must never be exposed to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI Gateway ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key

# --- Encryption ---
# Master key for AES-256-GCM encryption of stored provider keys.
# Must be exactly 32 bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The app refuses to start without this.
ENCRYPTION_MASTER_KEY=your-base64-32-byte-key

# --- Worker / scheduler ---
# Bearer token the scheduled worker routes require. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
WORKER_SECRET=your-worker-secret

# Only needed when Vercel Cron is the scheduler. Vercel injects this exact
# name into its own Authorization header and cannot be told to use
# WORKER_SECRET instead, so the worker routes accept either. Set it to the
# same value as WORKER_SECRET. Leave blank for any other scheduler.
# See docs/architecture/scheduling.md.
CRON_SECRET=

# --- Inngest (research pipeline orchestration) ---
# Optional locally: `npm run dev:inngest` runs the Inngest Dev Server, which
# this app auto-discovers with no keys needed. Required in production —
# from your Inngest app: Settings -> Event Keys / Signing Keys.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Error tracking (optional) ---
# Both unset: Sentry stays fully disabled, no transport attempted. See
# docs/architecture/error-tracking.md. From your Sentry project: Settings ->
# Client Keys (DSN). SENTRY_DSN covers server/edge; NEXT_PUBLIC_SENTRY_DSN
# covers the browser bundle and is exposed to the client by design.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
